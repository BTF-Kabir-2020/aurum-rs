# Copy this to .env for local dev. Never commit a real .env.
# Production gets values from the deployment environment (Docker / orchestrator), not a committed file.

# --- core app (AURUM_* wins over config.toml) ---
AURUM_CONFIG=config.toml
AURUM_MODE=demo
AURUM_SYMBOL=XAUUSD
AURUM_TIMEFRAME=5m
AURUM_SERVER_HOST=127.0.0.1
AURUM_SERVER_PORT=8080
AURUM_DB_PATH=./data/aurum.db
AURUM_DB_RETENTION_DAYS=90
AURUM_PROVIDER=massive
AURUM_UI_REFRESH_MS=1000

# --- secrets (keep out of config.toml, logs, and git) ---
MASSIVE_API_KEY=
MASSIVE_S3_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles

# --- runtime overrides (rarely needed) ---
AURUM_MASSIVE_BASE=https://api.massive.com

# --- logging (tracing) ---
RUST_LOG=info