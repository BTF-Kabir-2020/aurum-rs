# Template for a production deployment (inject via Docker env or a secret store).
# Shown values are defaults — override them in your real environment. Never commit secrets here.

AURUM_MODE=historical
AURUM_SYMBOL=XAUUSD
AURUM_TIMEFRAME=5m
AURUM_SERVER_HOST=0.0.0.0
AURUM_SERVER_PORT=8080
AURUM_DB_PATH=/data/aurum.db
AURUM_DB_RETENTION_DAYS=90
AURUM_PROVIDER=massive
AURUM_UI_REFRESH_MS=1000

MASSIVE_API_KEY=

RUST_LOG=warn